{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polymarket-odds-x402",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Payout wallet (Base). Replace before deploying for real.
    "PAYOUT_ADDRESS": "0xE5126f9Cf0fab2B709D932b2516Ade946ebD9629",
    // Testnet first. Flip to eip155:8453 (base mainnet) once the loop is proven.
    "NETWORK": "eip155:8453",
    // Testnet facilitator. Mainnet uses https://facilitator.payai.network
    "FACILITATOR_URL": "https://facilitator.payai.network"
  },
  // Request-level analytics. Query from CF dashboard SQL or the GraphQL API.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "polymarket_odds_x402" }
  ],
  // Odds-value time series: durable store for the Level 2 moat.
  // One row per served request (both 402 and paid). Seeds historical-odds
  // product once >=30 days of data accumulated.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gcalf-logs",
      "database_id": "b42f705f-8bb9-4904-9f22-ff4f177bb657"
    }
  ]
}
